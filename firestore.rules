rules_version = '2';

/**
 * FIRESTORE SECURITY RULES
 * ========================
 *
 * These rules control who can read/write data in Firestore.
 * All collections require authentication (user must be logged in).
 *
 * COLLECTIONS:
 * - scouting: Match scouting entries (all authenticated users)
 * - teams: Team statistics (all authenticated users)
 * - users: User profiles (users can only access their own)
 * - questions: Scouting form questions (read: all, write: admins)
 * - _diagnostics: Testing collection (all authenticated users)
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================================
    // SCOUTING COLLECTION
    // All authenticated users can read/write
    // ===========================================
    match /scouting/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ===========================================
    // TEAMS COLLECTION
    // All authenticated users can read
    // Write requires authentication
    // ===========================================
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ===========================================
    // USERS COLLECTION
    // Users can only read/write their own profile
    // ===========================================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ===========================================
    // QUESTIONS COLLECTION
    // All authenticated users can read
    // Only admins can write (checked in app code)
    // ===========================================
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ===========================================
    // DIAGNOSTICS COLLECTION
    // For testing - all authenticated users
    // ===========================================
    match /_diagnostics/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
