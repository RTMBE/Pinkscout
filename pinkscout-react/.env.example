# =============================================================================
# ENVIRONMENT VARIABLES - PinkScout React App
# =============================================================================
# 
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control!
#
# Vite requires the VITE_ prefix for variables to be exposed to the client.
# =============================================================================

# Firebase Configuration
# Get these from Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# External API Keys
# The Blue Alliance - Get from https://www.thebluealliance.com/account
VITE_TBA_API_KEY=your_tba_api_key_here

# FRC Nexus API Key (if needed)
VITE_NEXUS_API_KEY=your_nexus_api_key_here

# Primary Admin Email - User who always has admin access
VITE_PRIMARY_ADMIN_EMAIL=admin@example.com

