# =============================================================================
# ENVIRONMENT VARIABLES - PinkScout React App
# =============================================================================
# 
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control!
#
# Only non-secret values prefixed with VITE_ are exposed to the browser.
# Never put provider, database, or service-role secrets in a VITE_ variable.
# =============================================================================

# Supabase browser configuration. The publishable/anon key is intentionally
# public, but is safe only when every exposed table has correct RLS policies.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Configure these as server-only Vercel environment variables, never in this
# file or in the browser. See docs/SECURITY_DEPLOYMENT.md for the full list.
# TBA_API_KEY=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
